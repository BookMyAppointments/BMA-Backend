generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  phone         String?         @unique
  verifyCode    String?
  verified      Boolean         @default(false)
  gender        Gender?
  dob           DateTime?
  address       String?
  picture       String?
  locationId    String?
  role          Role            @default(NORMAL)

  // Health profile (shown on the patient's profile screen)
  bloodGroup    BloodGroup?
  heightCm      Float?
  weightKg      Float?

  // Phone OTP sign-in
  otpCode       String?
  otpExpiresAt  DateTime?
  payments      Payment[]
  medicalRecord MedicalRecord[]
  appointments  Appointment[]
  testResults   TestResult[]
  notifications Notification[]
  requests      Request[]
  reviews       Review[]
  hospitals     Hospital[]
  labs          Lab[]
  location      Location?       @relation(fields: [locationId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  remainders     Remainder[]
}

model Doctor {
  id             String         @id @default(uuid())
  email          String
  name           String
  phone          String?
  picture        String?
  specialization String[]
  qualifications String[]
  treats         PatientType[]  @default([MEN, WOMEN, CHILDREN])
  ratings        Float?
  about          String?
  price          Float
  noOfPatients   Int            @default(0)
  reviews        Review[]
  availability   Availability[]
  appointments   Appointment[]
  hospitalId     String?
  hospital       Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Hospital {
  id           String   @id @default(uuid())
  name         String
  picture      String?
  description  String?
  banner       String?
  address      String?
  departments  String[]
  facilities   String[]
  services     String[]
  hours        Json
  noOfPatients Int      @default(0)
  adminId      String?
  admin        User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  reviews      Review[]
  doctors      Doctor[]
  labs         Lab[]
  status       Status   @default(ACTIVE)
  locationId   String
  request      Request?
  location     Location @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emergencyStatus Boolean @default(false)
  noOfEmergencyPatients Int @default(0)
}

model Review {
  id         String    @id @default(uuid())
  userId     String?
  rating     Int
  comment    String?
  doctorId   String?
  hospitalId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor     Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  createdAt  DateTime  @default(now())
}

model Link {
  id        String   @id @default(uuid())
  url       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Availability {
  id        String  @id @default(uuid())
  day       String
  startTime String
  endTime   String
  doctorId  String?
  doctor    Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  lab       Lab?    @relation(fields: [labId], references: [id])
  labId     String?
}

model Lab {
  id           String         @id @default(uuid())
  name         String
  picture      String?
  description  String?
  banner       String?
  address      String?
  services     String[]
  hours        Json?
  noOfPatients Int            @default(0)
  locationId   String
  availability Availability[]
  location     Location       @relation(fields: [locationId], references: [id])
  hospitalId   String?
  tests        MedicalTest[]
  hospital     Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  status       Status         @default(ACTIVE)
  adminId      String?
  admin        User?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  request      Request?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Location {
  id        String     @id @default(uuid())
  lat       Float
  lng       Float
  address   String
  hospitals Hospital[]
  users     User[]
  labs      Lab[]
}

model Appointment {
  id            String            @id @default(uuid())
  userId        String
  doctorId      String?
  labId         String?
  testId        String?
  status        AppointmentStatus
  scheduledAt   DateTime
  rescheduledAt DateTime?
  cancelledAt   DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor        Doctor?           @relation(fields: [doctorId], references: [id])
  lab           Lab?              @relation(fields: [labId], references: [id])
  test          MedicalTest?      @relation(fields: [testId], references: [id])
  payment       Payment?
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

//* Who a doctor treats. Drives the Men / Women / Children filter on the home screen.
enum PatientType {
  MEN
  WOMEN
  CHILDREN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  PAY_AT_HOSPITAL
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  appointmentId     String?       @unique
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model MedicalTest {
  id           String        @id @default(uuid())
  name         String
  category     String
  price        Float
  homeSample   Boolean
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id], onDelete: Cascade)
  results      TestResult[]
  appointments Appointment[]
}

model TestResult {
  id        String      @id @default(uuid())
  userId    String
  testId    String
  resultUrl String
  notes     String?
  issuedAt  DateTime
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  test      MedicalTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      AppointmentStatus
  message   String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id        String   @id @default(uuid())
  userId    String   @unique
  history   String[]
  documents String[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Request {
  id         String    @id @default(uuid())
  userEmail  String
  expiryTime DateTime
  status     Status    @default(PENDING)
  hospitalId String?   @unique
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  labId      String?   @unique
  lab        Lab?      @relation(fields: [labId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
}

model BannerImages {
  id        String   @id @default(uuid())
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Remainder {
  id          String   @id @default(uuid())
  title       String
  description String?
  time        DateTime
  frequency   Frequency  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Role {
  NORMAL
  ADMIN
  SUPERADMIN
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  DELETED
}
